+    for (flavor, expected) in [(Flavor::Desktop, vec![4, 0]), (Flavor::Mac, vec![])] {
+        let opened = std::rc::Rc::new(std::cell::RefCell::new(Vec::new()));
+        let mut app = app(true);
+        app.services.native_menu = Some(NativeMenu::with_flavor(Box::new(Opener(opened.clone())), flavor));
+        let ctx = egui::Context::default();
+        for (key, modifiers) in [(Key::Y, Modifiers::ALT), (Key::F10, Modifiers::NONE)] {
+            let raw = egui::RawInput { events: vec![egui::Event::Key { key, physical_key: Some(key), pressed: true, repeat: false, modifiers }], ..Default::default() };
