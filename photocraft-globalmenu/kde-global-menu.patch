+/// Every level has the in-window menus' mnemonics: Photoshop's letters for the menus, and unique
+/// letters at each level.
+#[test]
+fn desktop_mnemonics_match_the_in_window_menus() {
+    let bar = desktop(Lang::EN);
+    let keys: String = bar.menus.iter().filter_map(|m| m.mnemonic).collect();
+    assert_eq!(keys, "FEILYSTVWH");
+    fn unique(nodes: &[Node]) {
+        let keys: Vec<char> = nodes
+            .iter()
+            .filter_map(|n| match n {
+                Node::Item(it) => it.mnemonic,
+                Node::Submenu { mnemonic, .. } => *mnemonic,
+                _ => None,
+            })
+            .collect();
+        let mut distinct = keys.clone();
+        distinct.sort_unstable();
+        distinct.dedup();
+        assert_eq!(distinct.len(), keys.len(), "{keys:?}");
+        for n in nodes {
+            if let Node::Submenu { children, .. } = n {
+                unique(children);
+            }
+        }
+    }
+    for m in &bar.menus {
+        unique(&m.children);
+    }
+    assert_eq!(bar.find("file.new").and_then(|it| it.mnemonic), Some('N'));
