+[package]
+name = "photocraft-kde-appmenu"
+version.workspace = true
+edition.workspace = true
+license.workspace = true
+description = "Link a winit window's Wayland surface to its D-Bus menu for KDE Plasma's global menu (org_kde_kwin_appmenu)"
+
+# An isolated `unsafe` helper crate, like photocraft-tablet: the appmenu object has to be created
+# on winit's own `wl_display` connection for winit's `wl_surface`, which needs foreign-display
+# interop. Only `set_address` allows `unsafe`; everything else is denied, and every other crate
+# keeps the workspace's `unsafe_code = "forbid"`.
+[lints.rust]
+unsafe_code = "deny"
+
+[lints.clippy]
+ cognitive_complexity = "deny"
+ too_many_arguments = "deny"
+ wildcard_imports = "deny"
+ dbg_macro = "warn"
+ todo = "warn"
+
+# Already in Cargo.lock (winit's Wayland backend pulls them in); pinned exactly: review the diff
+# before bumping.
+[target.'cfg(target_os = "linux")'.dependencies]
+wayland-client = { version = "=0.31.15", default-features = false }
+wayland-backend = { version = "=0.3.17", default-features = false, features = ["client_system"] }
+wayland-protocols-plasma = { version = "=0.3.12", default-features = false, features = ["client"] }
