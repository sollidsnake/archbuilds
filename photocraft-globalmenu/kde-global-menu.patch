@@ -0,0 +1,549 @@
+//! KDE Plasma's global menu: the menus served on the session bus as `com.canonical.dbusmenu` (the
+//! protocol Qt and GTK apps use there), laid out as the in-window menus are
+//! (`photocraft_ui_egui::native_menu::desktop_layout`). The menus themselves and how a click runs
+//! are in `native_menu`; this file serves them and links them to the window.
+//!
+//! - Installed only while the desktop shows a global menu, `com.canonical.AppMenu.Registrar` on
+//!   the session bus (Plasma's appmenu module owns it), as Qt decides for KDE apps. Otherwise,
+//!   or when anything here fails, the in-window menus stay. `--in-window-menus` keeps them too.
+//! - KWin links the window to the menu: on Wayland through `org_kde_kwin_appmenu`
+//!   (`photocraft_kde_appmenu`), on X11 through the `_KDE_NET_WM_APPMENU_*` window properties.
+//! - Items are numbered depth first, 0 being the root. A change of structure (an Open Recent file,
+//!   a document opened or closed, a language switch) renumbers them and sends `LayoutUpdated`;
+//!   labels, enabled and checked change in place (`ItemsPropertiesUpdated`).
+//! - A click (the "clicked" event) runs the item's command like an in-window click. Shortcuts are
+//!   only shown: the window keeps the keyboard, so they run in egui as usual. Alt+letter in the
+//!   window opens that menu in the panel (`ItemActivationRequested`).
+
+use std::collections::HashMap;
+use std::ffi::c_void;
+use std::ptr::NonNull;
+use std::sync::mpsc::{Receiver, Sender, channel};
+use std::sync::{Arc, Mutex, MutexGuard, PoisonError};
+
+use photocraft_ui_egui::native_menu::{self, Backend, Chord, Event, Flavor, MenuBar, NativeMenu, Node};
+use zbus::object_server::SignalEmitter;
+use zbus::zvariant::{OwnedValue, StructureBuilder, Value};
+
+/// Where the menu is served (the path Qt uses).
+const PATH: &str = "/MenuBar/1";
+/// Owned while the desktop shows global menus.
+const REGISTRAR: &str = "com.canonical.AppMenu.Registrar";
+
+/// Properties by name, as the protocol sends them.
+type Props = HashMap<String, Value<'static>>;
+/// An item and its children: `(ia{sv}av)`, the children being the same, each in a variant.
+type Layout = (i32, Props, Vec<Value<'static>>);
+
+/// One item as the protocol shows it.
+#[derive(Clone, Debug, PartialEq)]
+struct Row {
+    kind: Kind,
+    /// With its mnemonic marked ([`mnemonic_label`]).
+    label: String,
+    enabled: bool,
+    /// The ids of the items in it (the root, a menu or a submenu).
+    children: Vec<i32>,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+enum Kind {
+    Root,
+    /// A top menu or a submenu.
+    Menu,
+    Separator,
+    Item {
+        command: String,
+        /// [`shortcut`]; empty for none.
+        shortcut: Vec<Vec<String>>,
+        checked: Option<bool>,
+    },
+}
+
+/// What the bus thread serves and the app thread updates.
+struct Tree {
+    revision: u32,
+    rows: Vec<Row>,
+}
+
+/// The menu's rows, in id order, from the desktop layout.
+fn rows(bar: &MenuBar) -> Vec<Row> {
+    let mut rows = vec![Row { kind: Kind::Root, label: String::new(), enabled: true, children: Vec::new() }];
+    let tops: Vec<i32> = bar.menus.iter().map(|m| push_menu(&mut rows, &m.title, m.mnemonic, &m.children, true)).collect();
+    if let Some(root) = rows.first_mut() {
+        root.children = tops;
+    }
+    rows
+}
+
+/// Add a menu or submenu and everything in it; returns its id. A top menu is always enabled, as
+/// its in-window title is; a submenu only while something in it can run, as in the window.
+fn push_menu(rows: &mut Vec<Row>, title: &str, mnemonic: Option<char>, nodes: &[Node], top: bool) -> i32 {
+    let at = rows.len();
+    rows.push(Row { kind: Kind::Menu, label: mnemonic_label(title, mnemonic), enabled: true, children: Vec::new() });
+    let mut children = Vec::with_capacity(nodes.len());
+    let mut any_enabled = false;
+    for n in nodes {
+        let id = match n {
+            Node::Item(it) => {
+                any_enabled |= it.enabled;
+                let shortcut = it.shortcut.as_deref().and_then(shortcut).unwrap_or_default();
+                let kind = Kind::Item { command: it.id.clone(), shortcut, checked: it.checked };
+                push(rows, Row { kind, label: mnemonic_label(&it.label, it.mnemonic), enabled: it.enabled, children: Vec::new() })
+            }
+            Node::Separator => push(rows, Row { kind: Kind::Separator, label: String::new(), enabled: true, children: Vec::new() }),
+            Node::Submenu { label, children: inner, mnemonic, .. } => {
+                let id = push_menu(rows, label, *mnemonic, inner, false);
+                any_enabled |= row(rows, id).is_some_and(|r| r.enabled);
+                id
+            }
+            // macOS's own items; the desktop layout has none.
+            Node::Standard(_) => continue,
+        };
+        children.push(id);
+    }
+    if let Some(menu) = rows.get_mut(at) {
+        menu.children = children;
+        menu.enabled = top || any_enabled;
+    }
+    id_of(at)
+}
+
+fn push(rows: &mut Vec<Row>, row: Row) -> i32 {
+    rows.push(row);
+    id_of(rows.len() - 1)
+}
+
+fn id_of(index: usize) -> i32 {
+    i32::try_from(index).unwrap_or(i32::MAX)
+}
+
+fn row(rows: &[Row], id: i32) -> Option<&Row> {
+    rows.get(usize::try_from(id).ok()?)
+}
+
+/// `label` as the protocol writes it: `_` before the mnemonic's first occurrence (in any case),
+/// literal underscores doubled. Plasma underlines it and runs the row on that key.
+fn mnemonic_label(label: &str, mnemonic: Option<char>) -> String {
+    let mut out = String::with_capacity(label.len() + 1);
+    let mut pending = mnemonic.map(|c| c.to_ascii_uppercase());
+    for c in label.chars() {
+        if pending.is_some_and(|m| c.to_ascii_uppercase() == m) {
+            out.push('_');
+            pending = None;
+        }
+        if c == '_' {
+            out.push('_');
+        }
+        out.push(c);
+    }
+    out
+}
+
+/// A shortcut as the protocol writes it, one key combination of key names Qt reads:
+/// `Cmd+Shift+Z` is `[["Control", "Shift", "Z"]]`. `Cmd` is Ctrl off macOS (and Ctrl+Cmd one Ctrl).
+fn shortcut(s: &str) -> Option<Vec<Vec<String>>> {
+    let c = Chord::parse(s)?;
+    let mut keys: Vec<String> = [(c.cmd || c.ctrl, "Control"), (c.alt, "Alt"), (c.shift, "Shift")]
+        .into_iter()
+        .filter(|(on, _)| *on)
+        .map(|(_, name)| name.to_string())
+        .collect();
+    let key = match c.key.as_str() {
+        // libdbusmenu's names for these two.
+        "+" => "plus",
+        "-" => "minus",
+        "Delete" => "Del",
+        "Enter" => "Return",
+        "Escape" => "Esc",
+        "Insert" => "Ins",
+        "PageUp" => "PgUp",
+        "PageDown" => "PgDown",
+        "ArrowLeft" => "Left",
+        "ArrowRight" => "Right",
+        "ArrowUp" => "Up",
+        "ArrowDown" => "Down",
+        k => k,
+    };
+    keys.push(key.to_string());
+    Some(vec![keys])
+}
+
+/// A row's properties (only those that differ from the protocol's defaults, plus `enabled`).
+fn props(row: &Row) -> Props {
+    let mut p = Props::new();
+    let mut set = |name: &str, value: Value<'static>| {
+        p.insert(name.to_string(), value);
+    };
+    match &row.kind {
+        Kind::Root => set("children-display", "submenu".into()),
+        Kind::Menu => {
+            set("label", row.label.clone().into());
+            set("enabled", row.enabled.into());
+            set("children-display", "submenu".into());
+        }
+        Kind::Separator => set("type", "separator".into()),
+        Kind::Item { shortcut, checked, .. } => {
+            set("label", row.label.clone().into());
+            set("enabled", row.enabled.into());
+            if let Some(on) = checked {
+                set("toggle-type", "checkmark".into());
+                set("toggle-state", i32::from(*on).into());
+            }
+            if !shortcut.is_empty() {
+                set("shortcut", shortcut.clone().into());
+            }
+        }
+    }
+    p
+}
+
+/// `props` narrowed to `names` (all of them when `names` is empty).
+fn only(mut props: Props, names: &[String]) -> Props {
+    if !names.is_empty() {
+        props.retain(|k, _| names.contains(k));
+    }
+    props
+}
+
+/// The item `id` and its children `depth` levels down (all of them for -1).
+fn layout(rows: &[Row], id: i32, depth: i32, names: &[String]) -> Option<Layout> {
+    let r = row(rows, id)?;
+    let children = if depth == 0 {
+        Vec::new()
+    } else {
+        r.children
+            .iter()
+            .filter_map(|&child| layout(rows, child, depth.saturating_sub(1).max(-1), names))
+            .filter_map(|(id, props, children)| StructureBuilder::new().add_field(id).add_field(props).add_field(children).build().ok())
+            .map(Value::from)
+            .collect()
+    };
+    Some((id, only(props(r), names), children))
+}
+
+/// Do two menus differ only in labels, enabled and checked (else they are renumbered)?
+fn same_shape(a: &[Row], b: &[Row]) -> bool {
+    a.len() == b.len()
+        && a.iter().zip(b).all(|(x, y)| {
+            x.children == y.children
+                && match (&x.kind, &y.kind) {
+                    (Kind::Item { command: c1, shortcut: s1, checked: k1 }, Kind::Item { command: c2, shortcut: s2, checked: k2 }) => {
+                        c1 == c2 && s1 == s2 && k1.is_some() == k2.is_some()
+                    }
+                    (k1, k2) => std::mem::discriminant(k1) == std::mem::discriminant(k2),
+                }
+        })
+}
+
+fn lock(tree: &Mutex<Tree>) -> MutexGuard<'_, Tree> {
+    tree.lock().unwrap_or_else(PoisonError::into_inner)
+}
+
+/// The `com.canonical.dbusmenu` object, answering on zbus's thread.
+struct Server {
+    tree: Arc<Mutex<Tree>>,
+    clicks: Sender<String>,
+    repaint: egui::Context,
+}
+
+#[zbus::interface(name = "com.canonical.dbusmenu")]
+impl Server {
+    fn get_layout(&self, parent_id: i32, recursion_depth: i32, property_names: Vec<String>) -> zbus::fdo::Result<(u32, Layout)> {
+        let tree = lock(&self.tree);
+        let layout = layout(&tree.rows, parent_id, recursion_depth, &property_names).ok_or_else(|| zbus::fdo::Error::InvalidArgs(format!("no item {parent_id}")))?;
+        Ok((tree.revision, layout))
+    }
+
+    fn get_group_properties(&self, ids: Vec<i32>, property_names: Vec<String>) -> Vec<(i32, Props)> {
+        let tree = lock(&self.tree);
+        // No ids asks for every item.
+        let ids = if ids.is_empty() { (0..tree.rows.len()).map(id_of).collect() } else { ids };
+        ids.into_iter().filter_map(|id| Some((id, only(props(row(&tree.rows, id)?), &property_names)))).collect()
+    }
+
+    fn get_property(&self, id: i32, name: String) -> zbus::fdo::Result<Value<'static>> {
+        let tree = lock(&self.tree);
+        let r = row(&tree.rows, id).ok_or_else(|| zbus::fdo::Error::InvalidArgs(format!("no item {id}")))?;
+        props(r).remove(&name).ok_or_else(|| zbus::fdo::Error::InvalidArgs(format!("item {id} has no {name}")))
+    }
+
+    fn event(&self, id: i32, event_id: String, _data: OwnedValue, _timestamp: u32) -> zbus::fdo::Result<()> {
+        if self.handle(id, &event_id) { Ok(()) } else { Err(zbus::fdo::Error::InvalidArgs(format!("no item {id}"))) }
+    }
+
+    /// Returns the ids that aren't items.
+    fn event_group(&self, events: Vec<(i32, String, OwnedValue, u32)>) -> Vec<i32> {
+        events.into_iter().filter(|(id, event, _, _)| !self.handle(*id, event)).map(|(id, ..)| id).collect()
+    }
+
+    /// The menu is kept up to date as the app changes, so it never needs fetching again here.
+    fn about_to_show(&self, _id: i32) -> bool {
+        false
+    }
+
+    /// No updates needed; the ids that aren't items.
+    fn about_to_show_group(&self, ids: Vec<i32>) -> (Vec<i32>, Vec<i32>) {
+        let tree = lock(&self.tree);
+        (Vec::new(), ids.into_iter().filter(|&id| row(&tree.rows, id).is_none()).collect())
+    }
+
+    #[zbus(property)]
+    fn version(&self) -> u32 {
+        3
+    }
+
+    #[zbus(property)]
+    fn text_direction(&self) -> String {
+        if photocraft_ui_egui::direction::is_rtl() { "rtl" } else { "ltr" }.into()
+    }
+
+    #[zbus(property)]
+    fn status(&self) -> String {
+        "normal".into()
+    }
+
+    #[zbus(property)]
+    fn icon_theme_path(&self) -> Vec<String> {
+        Vec::new()
+    }
+
+    #[zbus(signal)]
+    async fn items_properties_updated(emitter: &SignalEmitter<'_>, updated_props: Vec<(i32, Props)>, removed_props: Vec<(i32, Vec<String>)>) -> zbus::Result<()>;
+
+    #[zbus(signal)]
+    async fn layout_updated(emitter: &SignalEmitter<'_>, revision: u32, parent: i32) -> zbus::Result<()>;
+
+    #[zbus(signal)]
+    async fn item_activation_requested(emitter: &SignalEmitter<'_>, id: i32, timestamp: u32) -> zbus::Result<()>;
+}
+
+impl Server {
+    /// An event on item `id`: a click on a command is queued for the app. False when there is no
+    /// such item.
+    fn handle(&self, id: i32, event: &str) -> bool {
+        let tree = lock(&self.tree);
+        let Some(r) = row(&tree.rows, id) else { return false };
+        if let (Kind::Item { command, .. }, "clicked") = (&r.kind, event) {
+            let _ = self.clicks.send(command.clone());
+            // Wake egui, so the command runs now rather than on the next mouse move.
+            self.repaint.request_repaint();
+        }
+        true
+    }
+}
+
+/// The global menu backend: the served tree, and the clicks from the bus thread.
+pub struct DbusMenu {
+    iface: zbus::blocking::object_server::InterfaceRef<Server>,
+    tree: Arc<Mutex<Tree>>,
+    clicks: Receiver<String>,
+    /// Kept open: the menu is served on it.
+    _conn: zbus::blocking::Connection,
+}
+
+impl DbusMenu {
+    fn emitter(&self) -> &SignalEmitter<'static> {
+        self.iface.signal_emitter()
+    }
+}
+
+impl Backend for DbusMenu {
+    fn sync(&mut self, bar: &MenuBar) {
+        let new = rows(bar);
+        let mut tree = lock(&self.tree);
+        if same_shape(&tree.rows, &new) {
+            let updated: Vec<(i32, Props)> = tree.rows.iter().zip(&new).enumerate().filter(|(_, (old, now))| old != now).map(|(i, (_, now))| (id_of(i), props(now))).collect();
+            tree.rows = new;
+            drop(tree);
+            if !updated.is_empty()
+                && let Err(e) = zbus::block_on(Server::items_properties_updated(self.emitter(), updated, Vec::new()))
+            {
+                log::warn!("global menu: couldn't update items: {e}");
+            }
+        } else {
+            tree.rows = new;
+            tree.revision = tree.revision.wrapping_add(1);
+            let revision = tree.revision;
+            drop(tree);
+            if let Err(e) = zbus::block_on(Server::layout_updated(self.emitter(), revision, 0)) {
+                log::warn!("global menu: couldn't update the layout: {e}");
+            }
+        }
+    }
+
+    fn drain(&mut self) -> Vec<Event> {
+        self.clicks.try_iter().map(Event::Click).collect()
+    }
+
+    fn open_menu(&mut self, index: usize) {
+        let id = lock(&self.tree).rows.first().and_then(|root| root.children.get(index)).copied();
+        if let Some(id) = id
+            && let Err(e) = zbus::block_on(Server::item_activation_requested(self.emitter(), id, 0))
+        {
+            log::warn!("global menu: couldn't open a menu: {e}");
+        }
+    }
+}
+
+/// How KWin is told which menu is the window's.
+enum Link {
+    X11(u32),
+    Wayland { display: NonNull<c_void>, surface: NonNull<c_void> },
+}
+
+impl Link {
+    fn of(cc: &eframe::CreationContext<'_>) -> Option<Link> {
+        use eframe::wgpu::rwh::{HasDisplayHandle, HasWindowHandle, RawDisplayHandle, RawWindowHandle};
+        match (cc.display_handle().ok()?.as_raw(), cc.window_handle().ok()?.as_raw()) {
+            (_, RawWindowHandle::Xlib(h)) => u32::try_from(h.window).ok().map(Link::X11),
+            (_, RawWindowHandle::Xcb(h)) => Some(Link::X11(h.window.get())),
+            (RawDisplayHandle::Wayland(d), RawWindowHandle::Wayland(w)) => Some(Link::Wayland { display: d.display, surface: w.surface }),
+            _ => None,
+        }
+    }
+
+    fn set(&self, service: &str, path: &str) -> Result<(), String> {
+        match self {
+            Link::X11(window) => set_x11_properties(*window, service, path),
+            Link::Wayland { display, surface } => photocraft_kde_appmenu::set_address(*display, *surface, service, path),
+        }
+    }
+}
+
+/// `_KDE_NET_WM_APPMENU_SERVICE_NAME` and `…_OBJECT_PATH` on the window, as Qt sets them.
+fn set_x11_properties(window: u32, service: &str, path: &str) -> Result<(), String> {
+    use x11rb::protocol::xproto::{AtomEnum, ConnectionExt as _, PropMode};
+    use x11rb::wrapper::ConnectionExt as _;
+    let (conn, _) = x11rb::rust_connection::RustConnection::connect(None).map_err(|e| e.to_string())?;
+    for (name, value) in [("_KDE_NET_WM_APPMENU_SERVICE_NAME", service), ("_KDE_NET_WM_APPMENU_OBJECT_PATH", path)] {
+        let atom = conn.intern_atom(false, name.as_bytes()).map_err(|e| e.to_string())?.reply().map_err(|e| e.to_string())?.atom;
+        conn.change_property8(PropMode::REPLACE, window, atom, AtomEnum::STRING, value.as_bytes())
+            .map_err(|e| e.to_string())?
+            .check()
+            .map_err(|e| e.to_string())?;
+    }
+    Ok(())
+}
+
+/// Serve the global menu and link it to the window, when the desktop shows one (in eframe's
+/// creator closure, where the window exists). None keeps the in-window menus.
+pub fn install(cc: &eframe::CreationContext<'_>, app: &photocraft_ui_egui::PhotocraftApp) -> Option<NativeMenu> {
+    match try_install(cc, app) {
+        Ok(menu) => menu,
+        Err(e) => {
+            log::warn!("couldn't set up the global menu ({e}); using the in-window menus");
+            None
+        }
+    }
+}
+
+fn try_install(cc: &eframe::CreationContext<'_>, app: &photocraft_ui_egui::PhotocraftApp) -> Result<Option<NativeMenu>, String> {
+    let Some(link) = Link::of(cc) else { return Ok(None) };
+    let conn = zbus::blocking::connection::Builder::session()
+        .and_then(|b| b.method_timeout(std::time::Duration::from_secs(2)).build())
+        .map_err(|e| e.to_string())?;
+    let dbus = zbus::blocking::fdo::DBusProxy::new(&conn).map_err(|e| e.to_string())?;
+    let registrar = zbus::names::BusName::try_from(REGISTRAR).map_err(|e| e.to_string())?;
+    if !dbus.name_has_owner(registrar).map_err(|e| e.to_string())? {
+        return Ok(None);
+    }
+    let language = &app.session.prefs().interface.language;
+    let bar = native_menu::desktop_layout(&photocraft_ui_egui::menus::menu_items(app), photocraft_ui_egui::i18n::Lang::from_pref(language));
+    let tree = Arc::new(Mutex::new(Tree { revision: 1, rows: rows(&bar) }));
+    let (tx, rx) = channel();
+    let server = Server { tree: Arc::clone(&tree), clicks: tx, repaint: cc.egui_ctx.clone() };
+    conn.object_server().at(PATH, server).map_err(|e| e.to_string())?;
+    let iface = conn.object_server().interface::<_, Server>(PATH).map_err(|e| e.to_string())?;
+    let service = conn.unique_name().ok_or("no bus name")?.to_string();
+    // Served before it is linked, as the protocol asks.
+    link.set(&service, PATH)?;
+    let menu = DbusMenu { iface, tree, clicks: rx, _conn: conn };
+    Ok(Some(NativeMenu::with_flavor(Box::new(menu), Flavor::Desktop)))
