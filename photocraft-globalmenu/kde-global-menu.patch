+/// ([`crate::menu_keys`]), "(F)" suffixes included.
+pub fn desktop_layout(items: &[MenuItem], lang: Lang) -> MenuBar {
+    let mut bar = from_items(&crate::menus::TOP_MENUS, items);
+    let (titles, keys) = crate::menu_keys::top_titles(lang);
+    for ((m, title), key) in bar.menus.iter_mut().zip(titles).zip(keys) {
