new file mode 100644
index 0000000..74a3789
--- /dev/null
+++ b/crates/kde-appmenu/src/lib.rs
@@ -0,0 +1,72 @@
+//! KDE Plasma's global menu on Wayland: tell KWin where a window's menu is on D-Bus.
+//!
+//! A Wayland client links a `wl_surface` to its `com.canonical.dbusmenu` object with KDE's
+//! `org_kde_kwin_appmenu` protocol (`set_address(service, path)`); Plasma's global menu then
+//! imports the menu of whichever window is active. The object must be created on the same
+//! `wl_display` connection as the surface, and the surface is winit's, so this plugs into winit's
+//! connection as a guest ([`wayland_backend::client::Backend::from_foreign_display`]): the one
+//! `unsafe` step, in [`set_address`].
+//!
+//! Everything created here lives as long as the process: KWin drops the menu with the surface,
+//! and dropping the guest connection while its objects are alive would leave libwayland routing
+//! later events (a new output's `wl_registry` global) to a destroyed queue.
+//!
+//! On X11 the same link is two window properties (`_KDE_NET_WM_APPMENU_SERVICE_NAME` and
+//! `…_OBJECT_PATH`), set by the app with x11rb and no `unsafe`.
+
+#![deny(clippy::unwrap_used, clippy::expect_used, clippy::panic, clippy::unimplemented, clippy::todo, clippy::unreachable)]
+
+#[cfg(target_os = "linux")]
+mod linux {
+    use std::ffi::c_void;
+    use std::ptr::NonNull;
+
+    use wayland_backend::client::{Backend, ObjectId};
+    use wayland_client::globals::{GlobalListContents, registry_queue_init};
+    use wayland_client::protocol::wl_registry::{self, WlRegistry};
+    use wayland_client::protocol::wl_surface::WlSurface;
+    use wayland_client::{Connection, Dispatch, Proxy, QueueHandle, delegate_noop};
+    use wayland_protocols_plasma::appmenu::client::org_kde_kwin_appmenu::OrgKdeKwinAppmenu;
+    use wayland_protocols_plasma::appmenu::client::org_kde_kwin_appmenu_manager::OrgKdeKwinAppmenuManager;
+
+    /// Our queue's state. The appmenu interfaces have no events, and the registry's later ones
+    /// (outputs coming and going) are never dispatched.
+    struct State;
+
+    impl Dispatch<WlRegistry, GlobalListContents> for State {
+        fn event(_: &mut Self, _: &WlRegistry, _: wl_registry::Event, _: &GlobalListContents, _: &Connection, _: &QueueHandle<Self>) {}
+    }
+
+    delegate_noop!(State: ignore OrgKdeKwinAppmenuManager);
+    delegate_noop!(State: ignore OrgKdeKwinAppmenu);
+
+    /// Link `surface` (winit's `wl_surface`, on `display`) to the D-Bus menu at `service`/`path`.
+    /// Fails, changing nothing, when the compositor has no `org_kde_kwin_appmenu_manager` (not
+    /// KWin) or the connection fails.
+    #[allow(unsafe_code)]
+    pub fn set_address(display: NonNull<c_void>, surface: NonNull<c_void>, service: &str, path: &str) -> Result<(), String> {
+        // SAFETY: `display` is winit's live `wl_display` (from the window's display handle), and
+        // winit keeps it connected for as long as the window exists. The guest backend made from
+        // it is never dropped (forgotten below), and is used only in this call, while the window
+        // that `display` belongs to is alive.
+        let backend = unsafe { Backend::from_foreign_display(display.as_ptr().cast()) };
+        let conn = Connection::from_backend(backend);
+        let (globals, queue) = registry_queue_init::<State>(&conn).map_err(|e| e.to_string())?;
+        let qh = queue.handle();
+        let manager: OrgKdeKwinAppmenuManager = globals.bind(&qh, 1..=2, ()).map_err(|e| e.to_string())?;
+        // SAFETY: `surface` is the window's live `wl_surface` proxy (from its window handle), on
+        // the same `display`. The id is used only to name the surface in `create` below, while
+        // the window, and so its surface, exist; `from_ptr` checks the proxy's interface.
+        let id = unsafe { ObjectId::from_ptr(WlSurface::interface(), surface.as_ptr().cast()) }.map_err(|e| e.to_string())?;
+        let surface = WlSurface::from_id(&conn, id).map_err(|e| e.to_string())?;
+        let appmenu = manager.create(&surface, &qh, ());
+        appmenu.set_address(service.to_string(), path.to_string());
+        conn.flush().map_err(|e| e.to_string())?;
+        // Kept for the process's life (see the module docs).
+        std::mem::forget((conn, queue, globals, manager, surface, appmenu));
+        Ok(())
+    }
+}
