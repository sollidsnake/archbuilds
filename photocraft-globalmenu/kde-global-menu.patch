+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn bar() -> MenuBar {
+        let app = photocraft_ui_egui::PhotocraftApp::new(photocraft_engine::Session::new(), photocraft_ui_egui::Services::default());
+        native_menu::desktop_layout(&photocraft_ui_egui::menus::menu_items(&app), photocraft_ui_egui::i18n::Lang::EN)
+    }
+
+    #[test]
+    fn mnemonics_are_marked_and_underscores_doubled() {
+        assert_eq!(mnemonic_label("File", Some('F')), "_File");
+        assert_eq!(mnemonic_label("Type", Some('Y')), "T_ype");
+        assert_eq!(mnemonic_label("snake_case", Some('C')), "snake___case");
+        assert_eq!(mnemonic_label("文件(F)", Some('F')), "文件(_F)");
+        assert_eq!(mnemonic_label("a_b", None), "a__b");
+    }
+
+    #[test]
+    fn shortcuts_use_qt_key_names() {
+        let sc = |s: &str| shortcut(s).and_then(|v| v.into_iter().next()).map(|keys| keys.join("+"));
+        assert_eq!(sc("Cmd+Shift+Z").as_deref(), Some("Control+Shift+Z"));
+        assert_eq!(sc("Ctrl+Cmd+M").as_deref(), Some("Control+M"));
+        assert_eq!(sc("Cmd++").as_deref(), Some("Control+plus"));
+        assert_eq!(sc("Cmd+-").as_deref(), Some("Control+minus"));
+        assert_eq!(sc("Alt+Delete").as_deref(), Some("Alt+Del"));
+        assert_eq!(sc("F5").as_deref(), Some("F5"));
+    }
+
+    /// The panel shows the in-window menus: File…Help with their mnemonics, every row once.
+    #[test]
+    fn rows_follow_the_in_window_menus() {
+        let bar = bar();
+        let rows = rows(&bar);
+        let root = &rows[0];
+        let titles: Vec<&str> = root.children.iter().map(|&id| row(&rows, id).unwrap().label.as_str()).collect();
+        assert_eq!(titles, ["_File", "_Edit", "_Image", "_Layer", "T_ype", "_Select", "Fil_ter", "_View", "_Window", "_Help"]);
+        let items = rows.iter().filter(|r| matches!(r.kind, Kind::Item { .. })).count();
+        assert_eq!(items, bar.items().len());
+        // Every child id points at a later row, so the tree has no cycles.
+        for (i, r) in rows.iter().enumerate() {
+            assert!(r.children.iter().all(|&c| usize::try_from(c).unwrap() > i));
+        }
+    }
+
+    #[test]
+    fn layout_nests_items_in_variants() {
+        let rows = rows(&bar());
+        let (id, props, children) = layout(&rows, 0, -1, &[]).unwrap();
+        assert_eq!(id, 0);
+        assert_eq!(props.get("children-display"), Some(&Value::from("submenu")));
+        assert_eq!(children.len(), 10);
+        // One level asked: the menus come without their items.
+        let (_, _, shallow) = layout(&rows, 0, 1, &["label".into()]).unwrap();
+        let Value::Structure(file) = &shallow[0] else { panic!("not a structure") };
+        let fields = file.fields();
+        assert_eq!(fields[0], Value::from(1i32));
+        assert!(matches!(&fields[2], Value::Array(a) if a.is_empty()));
+        assert!(layout(&rows, 100_000, -1, &[]).is_none());
+    }
+
+    #[test]
+    fn checked_and_enabled_change_in_place() {
+        let bar = bar();
+        let mut other = bar.clone();
+        let flip = |nodes: &mut Vec<Node>| {
+            for n in nodes {
+                if let Node::Item(it) = n {
+                    it.enabled = !it.enabled;
+                    it.checked = it.checked.map(|c| !c);
+                    it.label.push('!');
+                }
+            }
+        };
+        for m in &mut other.menus {
+            flip(&mut m.children);
+        }
+        assert!(same_shape(&rows(&bar), &rows(&other)));
+        // A new row renumbers.
+        if let Some(m) = other.menus.first_mut() {
+            m.children.push(Node::Separator);
+        }
+        assert!(!same_shape(&rows(&bar), &rows(&other)));
+    }
+}
