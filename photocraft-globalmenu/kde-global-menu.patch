+/// Translate one level's rows and submenus as the in-window menu shows them, give them their
+/// mnemonics, and do the same in each submenu.
+fn label_level(nodes: &mut [Node], lang: Lang) {
+    let (translated, english): (Vec<String>, Vec<&str>) = nodes
+        .iter()
+        .filter_map(|n| match n {
+            Node::Item(it) => Some((super::state::translated_label(lang, &it.id, &it.label), it.label.as_str())),
+            Node::Submenu { label, .. } => Some((tr(lang, label).to_string(), label.as_str())),
+            Node::Separator | Node::Standard(_) => None,
+        })
+        .unzip();
+    let (shown, keys) = crate::menu_keys::localized(&translated, &english, &[]);
+    let mut rows = shown.into_iter().zip(keys);
+    for n in nodes {
+        match n {
+            Node::Item(it) => {
+                if let Some((label, key)) = rows.next() {
+                    (it.label, it.mnemonic) = (label, key);
+                }
+            }
+            Node::Submenu { label, children, mnemonic, .. } => {
+                if let Some((shown, key)) = rows.next() {
+                    (*label, *mnemonic) = (shown, key);
+                }
+                label_level(children, lang);
+            }
+            Node::Separator | Node::Standard(_) => {}
+        }
+    }
