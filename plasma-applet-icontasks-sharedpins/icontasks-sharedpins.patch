--- a/launcherssource.h
+++ b/launcherssource.h
@@ -0,0 +1,80 @@
+/*
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#pragma once
+
+#include <QObject>
+#include <QPointer>
+#include <QTimer>
+#include <QVariantList>
+
+#include <qqmlregistration.h>
+
+#include <Plasma/Applet>
+
+class QQmlPropertyMap;
+
+namespace IconTasksSharedPins
+{
+
+/*
+ * Finds the other Task Manager widgets in plasmashell and resolves the one this
+ * widget takes its pinned apps (the "launchers" setting) from.
+ */
+class LaunchersSource : public QObject
+{
+    Q_OBJECT
+    QML_ELEMENT
+
+    // The widget this object works for (Plasmoid in QML).
+    Q_PROPERTY(Plasma::Applet *applet READ applet WRITE setApplet NOTIFY appletChanged)
+    // Id of the widget to take the pinned apps from, 0 for the widget's own list.
+    Q_PROPERTY(int sourceId READ sourceId WRITE setSourceId NOTIFY sourceIdChanged)
+    // The widget whose pinned apps are shared, or null when the own list is used.
+    // Chains (A follows B, B follows C) resolve to the last widget found.
+    Q_PROPERTY(Plasma::Applet *source READ source NOTIFY sourceChanged)
+    // The other Task Manager widgets as [{ value: id, text: description }].
+    Q_PROPERTY(QVariantList candidates READ candidates NOTIFY candidatesChanged)
+
+public:
+    explicit LaunchersSource(QObject *parent = nullptr);
+
+    Plasma::Applet *applet() const;
+    void setApplet(Plasma::Applet *applet);
+
+    int sourceId() const;
+    void setSourceId(int id);
+
+    Plasma::Applet *source() const;
+    QVariantList candidates() const;
+
+Q_SIGNALS:
+    void appletChanged();
+    void sourceIdChanged();
+    void sourceChanged();
+    void candidatesChanged();
+
+private Q_SLOTS:
+    void scheduleRefresh();
+
+private:
+    void refresh();
+    QList<Plasma::Applet *> taskManagers() const;
+    void watchProperty(QQmlPropertyMap *map, const char *name);
+    QString describe(Plasma::Applet *applet) const;
+
+    static QQmlPropertyMap *configurationOf(Plasma::Applet *applet);
+    static int sourceIdOf(Plasma::Applet *applet);
+
+    QPointer<Plasma::Applet> m_applet;
+    int m_sourceId = 0;
+    QPointer<Plasma::Applet> m_source;
+    QVariantList m_candidates;
+
+    // Connections to other widgets and containments, redone on each refresh.
+    QList<QMetaObject::Connection> m_watches;
+    QTimer m_refreshTimer;
+};
+
+} // namespace IconTasksSharedPins
