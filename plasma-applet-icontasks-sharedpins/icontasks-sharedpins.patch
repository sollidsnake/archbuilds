+/*
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "launcherssource.h"
+
+#include <KLocalizedString>
+
+#include <Plasma/Containment>
+#include <Plasma/Corona>
+
+#include <QGuiApplication>
+#include <QMetaMethod>
+#include <QQmlPropertyMap>
+#include <QScreen>
+#include <QSet>
+
+using namespace Qt::StringLiterals;
+using namespace IconTasksSharedPins;
+
+namespace
+{
+bool isTaskManager(const Plasma::Applet *applet)
+{
+    const QString plugin = applet->pluginName();
+    return plugin == "org.kde.plasma.taskmanager"_L1 || plugin == "org.kde.plasma.icontasks"_L1 || plugin == "org.archbuilds.icontasks"_L1;
+}
+}
+
+LaunchersSource::LaunchersSource(QObject *parent)
+    : QObject(parent)
+{
+    m_refreshTimer.setSingleShot(true);
+    m_refreshTimer.setInterval(0);
+    connect(&m_refreshTimer, &QTimer::timeout, this, &LaunchersSource::refresh);
+}
+
+Plasma::Applet *LaunchersSource::applet() const
+{
+    return m_applet;
+}
+
+void LaunchersSource::setApplet(Plasma::Applet *applet)
+{
+    if (m_applet == applet) {
+        return;
+    }
+    m_applet = applet;
+    Q_EMIT appletChanged();
+    refresh();
+}
+
+int LaunchersSource::sourceId() const
+{
+    return m_sourceId;
+}
+
+void LaunchersSource::setSourceId(int id)
+{
+    if (m_sourceId == id) {
+        return;
+    }
+    m_sourceId = id;
+    Q_EMIT sourceIdChanged();
+    refresh();
+}
+
+Plasma::Applet *LaunchersSource::source() const
+{
+    return m_source;
+}
+
+QVariantList LaunchersSource::candidates() const
+{
+    return m_candidates;
+}
+
+void LaunchersSource::scheduleRefresh()
+{
+    m_refreshTimer.start();
+}
+
+QQmlPropertyMap *LaunchersSource::configurationOf(Plasma::Applet *applet)
+{
+    return qobject_cast<QQmlPropertyMap *>(applet->property("configuration").value<QObject *>());
+}
+
+int LaunchersSource::sourceIdOf(Plasma::Applet *applet)
+{
+    const QQmlPropertyMap *map = configurationOf(applet);
+    return map ? map->value(u"launchersSource"_s).toInt() : 0;
+}
+
+QList<Plasma::Applet *> LaunchersSource::taskManagers() const
+{
+    QList<Plasma::Applet *> result;
+    Plasma::Containment *containment = m_applet ? m_applet->containment() : nullptr;
+    Plasma::Corona *corona = containment ? containment->corona() : nullptr;
+    if (!corona) {
+        return result;
+    }
+    const auto containments = corona->containments();
+    for (Plasma::Containment *c : containments) {
+        if (c->destroyed()) {
+            continue;
+        }
+        const auto applets = c->applets();
+        for (Plasma::Applet *a : applets) {
+            if (!a->destroyed() && isTaskManager(a)) {
+                result << a;
+            }
+        }
+    }
+    return result;
+}
+
+void LaunchersSource::watchProperty(QQmlPropertyMap *map, const char *name)
+{
+    // QQmlPropertyMap::valueChanged() misses changes made from C++, the
+    // property's own notify signal doesn't.
+    const QMetaObject *mo = map->metaObject();
+    const int index = mo->indexOfProperty(name);
+    if (index >= 0 && mo->property(index).hasNotifySignal()) {
+        static const QMetaMethod slot = staticMetaObject.method(staticMetaObject.indexOfSlot("scheduleRefresh()"));
+        m_watches << connect(map, mo->property(index).notifySignal(), this, slot);
+    } else {
+        m_watches << connect(map, &QQmlPropertyMap::valueChanged, this, &LaunchersSource::scheduleRefresh);
+    }
+}
+
+QString LaunchersSource::describe(Plasma::Applet *applet) const
+{
+    Plasma::Containment *containment = applet->containment();
+
+    QString where;
+    if (containment) {
+        if (const auto type = containment->containmentType(); type == Plasma::Containment::Panel || type == Plasma::Containment::CustomPanel) {
+            switch (containment->location()) {
+            case Plasma::Types::TopEdge:
+                where = i18nc("@item:inlistbox location of a task manager", "top panel");
+                break;
+            case Plasma::Types::BottomEdge:
+                where = i18nc("@item:inlistbox location of a task manager", "bottom panel");
+                break;
+            case Plasma::Types::LeftEdge:
+                where = i18nc("@item:inlistbox location of a task manager", "left panel");
+                break;
+            case Plasma::Types::RightEdge:
+                where = i18nc("@item:inlistbox location of a task manager", "right panel");
+                break;
+            default:
+                where = i18nc("@item:inlistbox location of a task manager", "panel");
+                break;
+            }
+        } else {
+            where = i18nc("@item:inlistbox location of a task manager", "desktop");
+        }
+
+        const QRect geometry = containment->screenGeometry().toRect();
+        QString screenName;
+        if (int(containment->screen()) >= 0) {
+            const auto screens = QGuiApplication::screens();
+            for (const QScreen *screen : screens) {
+                if (screen->geometry() == geometry) {
+                    screenName = screen->name();
+                    break;
+                }
+            }
+            if (screenName.isEmpty()) {
+                screenName = QString::number(containment->screen() + 1);
+            }
+            where = i18nc("@item:inlistbox %1 is a panel or the desktop, %2 a screen name", "%1 on %2", where, screenName);
+        }
+    }
+
+    const QQmlPropertyMap *map = configurationOf(applet);
+    const int count = map ? map->value(u"launchers"_s).toStringList().size() : 0;
+
+    if (where.isEmpty()) {
+        return i18ncp("@item:inlistbox %2 is a widget name", "%2 (%1 pinned app)", "%2 (%1 pinned apps)", count, applet->title());
+    }
+    return i18ncp("@item:inlistbox %2 is a widget name, %3 where it is",
+                  "%2, %3 (%1 pinned app)",
+                  "%2, %3 (%1 pinned apps)",
+                  count,
+                  applet->title(),
+                  where);
+}
+
+void LaunchersSource::refresh()
+{
+    m_refreshTimer.stop();
+
+    for (const auto &connection : std::as_const(m_watches)) {
+        disconnect(connection);
+    }
+    m_watches.clear();
+
+    const QList<Plasma::Applet *> all = taskManagers();
+
+    if (m_applet) {
+        m_watches << connect(m_applet, &Plasma::Applet::containmentChanged, this, &LaunchersSource::scheduleRefresh);
+        if (Plasma::Containment *own = m_applet->containment()) {
+            if (Plasma::Corona *corona = own->corona()) {
+                m_watches << connect(corona, &Plasma::Corona::containmentAdded, this, &LaunchersSource::scheduleRefresh);
+                const auto containments = corona->containments();
+                for (Plasma::Containment *c : containments) {
+                    m_watches << connect(c, &Plasma::Containment::appletsChanged, this, &LaunchersSource::scheduleRefresh);
+                    m_watches << connect(c, &Plasma::Containment::screenChanged, this, &LaunchersSource::scheduleRefresh);
+                    m_watches << connect(c, &Plasma::Containment::locationChanged, this, &LaunchersSource::scheduleRefresh);
+                    m_watches << connect(c, &QObject::destroyed, this, &LaunchersSource::scheduleRefresh);
+                }
+            }
+        }
+    }
+
+    for (Plasma::Applet *a : all) {
+        m_watches << connect(a, &Plasma::Applet::destroyedChanged, this, &LaunchersSource::scheduleRefresh);
+        m_watches << connect(a, &QObject::destroyed, this, &LaunchersSource::scheduleRefresh);
+        if (QQmlPropertyMap *map = configurationOf(a)) {
+            watchProperty(map, "launchersSource");
+            if (a != m_applet) {
+                watchProperty(map, "launchers");
+            }
+        }
+    }
+
+    // Candidates: every other Task Manager.
+    QVariantList candidates;
+    for (Plasma::Applet *a : all) {
+        if (a == m_applet) {
+            continue;
+        }
+        candidates << QVariantMap{{u"value"_s, int(a->id())}, {u"text"_s, describe(a)}};
+    }
+    if (candidates != m_candidates) {
+        m_candidates = candidates;
+        Q_EMIT candidatesChanged();
+    }
+
+    // Follow the chain of sources; stop at a missing widget or a loop.
+    Plasma::Applet *resolved = nullptr;
+    if (m_applet) {
+        QSet<uint> seen{m_applet->id()};
+        int id = m_sourceId;
+        while (id > 0 && !seen.contains(uint(id))) {
+            Plasma::Applet *next = nullptr;
+            for (Plasma::Applet *a : all) {
+                if (a->id() == uint(id)) {
+                    next = a;
+                    break;
+                }
+            }
+            if (!next) {
+                break;
+            }
+            resolved = next;
+            seen.insert(next->id());
+            id = sourceIdOf(next);
+        }
+    }
+
+    if (m_source != resolved) {
+        m_source = resolved;
+        Q_EMIT sourceChanged();
+    }
+}
