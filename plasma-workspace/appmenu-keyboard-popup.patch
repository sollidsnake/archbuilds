+// HACK Qt only creates grabbing popups once the process has received some input (for the seat and serial of the
+// grab). Right after plasmashell starts that may not have happened yet, so a menu opened from the keyboard would
+// fail until the panel is clicked. Same as AppMenuModule::ensureSerial() in the appmenu kded module.
+static void ensureInputSerial(QWindow *window)
+{
+    auto waylandWindow = dynamic_cast<QtWaylandClient::QWaylandWindow *>(window->handle());
+    if (!waylandWindow || waylandWindow->display()->lastInputDevice()) {
+        return;
+    }
+    QtWaylandClient::QWaylandDisplay *display = waylandWindow->display();
+#ifdef HAVE_QT_WAYLAND_SETLASTINPUTDEVICE_SURFACE
+    display->setLastInputDevice(display->currentInputDevice(), 1, waylandWindow->waylandSurface());
+#else
+    display->setLastInputDevice(display->currentInputDevice(), 1, waylandWindow);
+#endif
+}
