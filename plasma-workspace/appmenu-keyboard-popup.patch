+bool AppMenuModel::handlesActivationRequests() const
+{
+    // Every applet showing this window's menu (e.g. a panel on each screen, with menus for all screens enabled)
+    // receives the app's Alt+<mnemonic> request. If all of them open a grabbing popup, the later ones get nested
+    // into the first one and keyboard focus ends up in a menu on the wrong screen. So only one of them reacts:
+    // the one on the window's screen, or else the first one.
+    const QRect windowScreen = m_tasksModel->data(m_tasksModel->activeTask(), TaskManager::AbstractTasksModel::ScreenGeometry).toRect();
+    const AppMenuModel *handler = nullptr;
+    for (const AppMenuModel *model : std::as_const(s_models)) {
+        if (!model->m_menuAvailable || !model->m_menu || model->m_serviceName != m_serviceName || model->m_menuObjectPath != m_menuObjectPath) {
+            continue;
+        }
+        if (model->screenGeometry() == windowScreen) {
+            return model == this;
+        }
+        if (!handler) {
+            handler = model;
+        }
+    }
+    return handler == this;
+}
