+
+    // The app owns these mnemonics (it handles Alt+<letter> and asks us to open that menu), so underline the letter it
+    // marked with '&'. Kirigami.MnemonicData picks letters from a pool shared by all of plasmashell, where the buttons
+    // from before the last model reset (deleted later) and the global menus on other panels still hold them: labels got
+    // underlined on the wrong letter or not at all. Here it only provides the plain label, disabled to stay out of it.
+    Kirigami.MnemonicData.enabled: false
     Kirigami.MnemonicData.label: text
 
+    // "&&" is a literal '&'. '&' before a letter or digit marks the mnemonic, the first one counts, like in Qt.
+    // Anything but whitespace and ASCII punctuation is taken as a letter here, QML's regexps can't do \p{L}.
+    function mnemonicRichText(label: string): string {
+        const escape = s => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
+        let underlined = false;
+        return label.split(/(&&|&[^\s!-\/:-@\[-`{-~])/).map(part => {
+            if (part === "&&") {
+                return "&amp;";
+            } else if (part.length === 2 && part[0] === "&") {
+                if (underlined) {
+                    return escape(part[1]);
+                }
+                underlined = true;
+                return "<u>" + escape(part[1]) + "</u>";
+            }
+            return escape(part);
+        }).join("");
+    }
